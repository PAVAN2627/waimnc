# Wai Municipal Council NestJS Backend Environment Variables

PORT=3001
NODE_ENV=development

# PostgreSQL Connection Strings (e.g. Supabase)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# JWT Secret for Session Security
JWT_SECRET="wmc_super_secure_jwt_secret_change_in_production_2026"

# Vercel Blob Storage Credentials
BLOB_STORE_ID="store_..."
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Cloudflare R2 Object Storage (Optional / Alternate)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="wmc-media"
R2_PUBLIC_DOMAIN="https://media.waimunicipalcouncil.org"
