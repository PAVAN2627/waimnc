# 1. LOCAL DEVELOPMENT CONFIGURATION
# PORT=3001
# NODE_ENV=development
# DATABASE_URL="postgresql://postgres:password@localhost:5432/wmc_db"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/wmc_db"
# REDIS_URL="redis://localhost:6379"

# 2. PRODUCTION CONFIGURATION (RENDER / ORACLE CLOUD)
PORT=3001
NODE_ENV=production
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
REDIS_URL="redis://localhost:6379"

# 3. COMMON KEYS (SHARED FOR BOTH LOCAL & PRODUCTION)
JWT_SECRET="your_strong_jwt_secret_change_in_production"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="waimuncipal"
R2_PUBLIC_DOMAIN="https://media.waimunicipalcouncil.org"
